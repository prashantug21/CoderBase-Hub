{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js Debugging",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": ["--inspect-brk", ".next/server/pages"],
        "port": 9229,
        "skipFiles": ["<node_internals>/**"],
        "sourceMaps": true,
        "smartStep": true,
        "restart": true,
        "timeout": 30000,
        "outputCapture": "std",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "development"
        },
        "sourceMapPathOverrides": {
          "webpack:///./*": "${workspaceFolder}/*",
          "webpack:///src/*": "${workspaceFolder}/src/*",
          "webpack:///pages/*": "${workspaceFolder}/pages/*"
        }
      }
    ]
  }
  